{
  "doctype": "DocType",
  "name": "Stock Movement",
  "module": "Textile ERP",
  "autoname": "naming_series:",
  "is_submittable": 1,
  "engine": "InnoDB",
  "track_changes": 1,
  "field_order": [
    "naming_series",
    "posting_date",
    "item",
    "movement_type",
    "qty",
    "production_order",
    "reference",
    "notes"
  ],
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Series",
      "options": "STK-.YYYY.-.#####",
      "default": "STK-.YYYY.-.#####",
      "reqd": 1
    },
    {
      "fieldname": "posting_date",
      "fieldtype": "Date",
      "label": "Posting Date",
      "default": "Today",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "item",
      "fieldtype": "Link",
      "label": "Item",
      "options": "Textile Item",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "movement_type",
      "fieldtype": "Select",
      "label": "Movement Type",
      "options": "Receipt\nIssue",
      "default": "Receipt",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "qty",
      "fieldtype": "Float",
      "label": "Quantity",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "production_order",
      "fieldtype": "Link",
      "label": "Production Order",
      "options": "Production Order",
      "read_only": 1
    },
    {
      "fieldname": "reference",
      "fieldtype": "Data",
      "label": "Reference"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "Notes"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "report": 1
    },
    {
      "role": "Textile Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "report": 1
    },
    {
      "role": "Inventory Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "report": 1
    },
    {
      "role": "Production Manager",
      "read": 1,
      "report": 1
    }
  ]
}
