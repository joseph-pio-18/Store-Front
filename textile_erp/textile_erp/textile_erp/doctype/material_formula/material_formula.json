{
  "doctype": "DocType",
  "name": "Material Formula",
  "module": "Textile ERP",
  "autoname": "naming_series:",
  "is_submittable": 1,
  "engine": "InnoDB",
  "track_changes": 1,
  "field_order": [
    "naming_series",
    "finished_product",
    "is_active",
    "section_break_materials",
    "materials"
  ],
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Series",
      "options": "BOM-.YYYY.-.#####",
      "default": "BOM-.YYYY.-.#####",
      "reqd": 1
    },
    {
      "fieldname": "finished_product",
      "fieldtype": "Link",
      "label": "Finished Product",
      "options": "Textile Item",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Active",
      "default": "1"
    },
    {
      "fieldname": "section_break_materials",
      "fieldtype": "Section Break",
      "label": "Raw Materials"
    },
    {
      "fieldname": "materials",
      "fieldtype": "Table",
      "label": "Materials",
      "options": "Material Formula Item",
      "reqd": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "report": 1
    },
    {
      "role": "Textile Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "report": 1
    },
    {
      "role": "Production Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1,
      "report": 1
    },
    {
      "role": "Inventory Manager",
      "read": 1,
      "report": 1
    }
  ]
}
