{
  "doctype": "DocType",
  "name": "Store Order",
  "module": "Textile ERP",
  "autoname": "naming_series:",
  "engine": "InnoDB",
  "track_changes": 1,
  "field_order": [
    "naming_series",
    "customer",
    "customer_name",
    "customer_email",
    "order_date",
    "expected_delivery_date",
    "status",
    "stock_reserved",
    "section_break_items",
    "items",
    "currency",
    "total_amount"
  ],
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Series",
      "options": "ORD-.YYYY.-.#####",
      "default": "ORD-.YYYY.-.#####",
      "reqd": 1
    },
    {
      "fieldname": "customer",
      "fieldtype": "Link",
      "label": "Customer Account",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "customer_name",
      "fieldtype": "Data",
      "label": "Customer Name",
      "read_only": 1
    },
    {
      "fieldname": "customer_email",
      "fieldtype": "Data",
      "label": "Customer Email",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "order_date",
      "fieldtype": "Date",
      "label": "Order Date",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "expected_delivery_date",
      "fieldtype": "Date",
      "label": "Expected Delivery Date",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Order Status",
      "options": "Pending\nProcessing\nCompleted\nCancelled",
      "default": "Pending",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "stock_reserved",
      "fieldtype": "Check",
      "label": "Variant Stock Reserved",
      "default": "0",
      "read_only": 1
    },
    {
      "fieldname": "section_break_items",
      "fieldtype": "Section Break",
      "label": "Ordered Products"
    },
    {
      "fieldname": "items",
      "fieldtype": "Table",
      "label": "Products",
      "options": "Store Order Item",
      "reqd": 1
    },
    {
      "fieldname": "currency",
      "fieldtype": "Link",
      "label": "Currency",
      "options": "Currency",
      "read_only": 1
    },
    {
      "fieldname": "total_amount",
      "fieldtype": "Currency",
      "label": "Order Total",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "export": 1,
      "report": 1
    },
    {
      "role": "Textile Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "export": 1,
      "report": 1
    },
    {
      "role": "Inventory Manager",
      "read": 1,
      "report": 1
    }
  ]
}
